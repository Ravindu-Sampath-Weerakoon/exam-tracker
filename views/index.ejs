<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Exam Tracker</title>
  <link rel="stylesheet" href="css/styles.css" />
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="navbar-container">
      <div class="nav-section nav-left">
        <a href="/" class="nav-logo">
          <span class="logo-icon">🎓</span>
          <span class="logo-text">ExamTracker</span>
        </a>
        <div class="nav-search">
          <svg class="search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" id="subjectSearch" placeholder="Search subjects..." autocomplete="off">
        </div>
      </div>

      <div id="hoverSubjectName" class="hover-subject-name"></div>

      <div class="nav-section nav-right">
        <!-- Overall Progress Pill -->
        <div class="progress-pill" title="Overall Progress">
          <div class="progress-pill-chart">
            <svg viewBox="0 0 36 36" class="circular-chart-nav">
              <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
              <path class="circle" stroke-dasharray="<%= overallProgress %>, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
            </svg>
          </div>
          <span class="nav-percent"><%= overallProgress %>%</span>
        </div>

        <div class="nav-actions">
          <button class="action-btn" onclick="toggleCalendarModal()" title="Calendar">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          </button>

          <button class="action-btn highlight" onclick="toggleModal('addSubjectModal')" title="Add Subject">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </button>
          
          <div class="dropdown">
            <button class="action-btn dropbtn" title="More Options">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
            </button>
            <div class="dropdown-content">
              <a href="#" onclick="toggleModal('hiddenSubjectsModal'); return false;">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                Hidden Subjects
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>

  
  <main class="container">
    <!-- Subject Cards -->
    <% subjects.forEach(subject => {
      const diffDays = subject.daysRemaining >= 0 ? subject.daysRemaining : 0;
      const percent = progress[subject.id] || 0;
      const subjectTopics = topics.filter(t => t.subject_id === subject.id);

      let formattedExamDate = 'Not set';
      if (subject.exam_date) {
        const examDate = new Date(subject.exam_date);
        if (!isNaN(examDate)) {
          const options = { year: 'numeric', month: 'short', day: 'numeric' };
          formattedExamDate = examDate.toLocaleDateString('en-US', options);
        }
      }
    %>
    <div class="card collapsed" id="subject-card-<%= subject.id %>">
      <div class="card-header">
        <div class="header-main" onclick="toggleCard('<%= subject.id %>')">
          <span class="toggle-icon">▼</span>
          <h3><%= subject.name %></h3>
        </div>
        <span class="badge notification-badge">There are <%= diffDays %> day<%= diffDays === 1 ? '' : 's' %> left for exam. Wish you all the best!</span>
        <div class="card-actions">
          <button class="action-btn filter-toggle" onclick="toggleFilter('<%= subject.id %>', this)" title="Show Remaining Only">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
          </button>
          <div class="dropdown">
            <button class="action-btn dropbtn" title="Subject Options">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
            </button>
            <div class="dropdown-content">
              <a href="#" onclick="openAddTopicModalForSubject('<%= subject.id %>'); return false;">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Add Topic
              </a>
              <a href="#" onclick="openEditSubjectModal('<%= subject.id %>', '<%= subject.name %>', '<%= subject.exam_date %>'); return false;">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                Edit Subject
              </a>
              <form action="/subjects/hide" method="POST" style="display: none;" id="hide-form-<%= subject.id %>">
                <input type="hidden" name="id" value="<%= subject.id %>">
              </form>
              <a href="#" onclick="document.getElementById('hide-form-<%= subject.id %>').submit(); return false;">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                Hide Subject
              </a>
              <div class="dropdown-divider"></div>
              <form action="/subjects/delete" method="POST" style="display: none;" id="delete-form-<%= subject.id %>">
                <input type="hidden" name="id" value="<%= subject.id %>">
              </form>
              <a href="#" onclick="if(confirm('Are you sure?')) { document.getElementById('delete-form-<%= subject.id %>').submit(); } return false;" class="delete-btn-style">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                Delete
              </a>
            </div>
          </div>
        </div>
      </div>
      <div class="exam-date">📅 <%= formattedExamDate %></div>
      
      <div class="card-stats">
        <div class="stat-item">
          <span class="stat-label">Done</span>
          <span class="stat-value count-done"><%= subjectTopics.filter(t => t.status === 'done').length %></span>
        </div>
        <div class="stat-item">
          <span class="stat-label">Remaining</span>
          <span class="stat-value count-rem"><%= subjectTopics.filter(t => t.status !== 'done').length %></span>
        </div>
        <div class="stat-item">
          <span class="stat-label">Total</span>
          <span class="stat-value count-total"><%= subjectTopics.length %></span>
        </div>
      </div>

      <div class="progress-bar-outer">
        <div class="progress-bar-inner bg-blue" style="width: <%= percent %>%"></div>
      </div>
      <small>Progress: <%= percent %>%</small>

      <div class="card-body">
        <ul class="topic-list">
          <% subjectTopics.forEach(topic => { %>
            <li class="topic-item <%= topic.status === 'done' ? 'done' : '' %>" data-topic-id="<%= topic.id %>">
              <div class="topic-content">
                <span class="topic-title"><%= topic.title %></span>
                <p class="topic-description"><%= topic.description || '' %></p>
              </div>
              <div class="topic-actions">
                <button class="topic-action-btn edit-topic-btn" 
                        data-id="<%= topic.id %>" 
                        data-title="<%= topic.title %>" 
                        data-description="<%= topic.description || '' %>" 
                        title="Edit Topic">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                </button>
                <form action="/topics/delete" method="POST" style="display: inline;">
                  <input type="hidden" name="id" value="<%= topic.id %>">
                  <button type="submit" class="topic-action-btn delete" onclick="return confirm('Are you sure you want to delete this topic?')" title="Delete Topic">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                  </button>
                </form>
                <form action="/topics/toggle" method="POST" style="display: inline;">
                  <input type="hidden" name="topic_id" value="<%= topic.id %>" />
                  <input type="hidden" name="status" value="<%= topic.status === 'done' ? 'todo' : 'done' %>" />
                  <button class="topic-toggle-btn <%= topic.status === 'done' ? 'done' : 'todo' %>" 
                          data-topic-id="<%= topic.id %>" 
                          data-status="<%= topic.status === 'done' ? 'todo' : 'done' %>"
                          title="<%= topic.status === 'done' ? 'Undo' : 'Mark as done' %>">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  </button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
        <div class="card-footer">
          <button class="fold-btn" onclick="toggleCard('<%= subject.id %>')">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><polyline points="18 15 12 9 6 15"></polyline></svg>
            Fold Card
          </button>
        </div>
      </div>
    </div>
    <% }) %>
  </main>

  <!-- Add Subject Modal -->
  <div id="addSubjectModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="toggleModal('addSubjectModal')">&times;</span>
      <h3>Add New Subject</h3>
      <form action="/subjects/add" method="POST">
        <input type="text" name="name" placeholder="Subject Name" required />
        <input type="date" name="exam_date" required />
        <button type="submit">Add Subject</button>
      </form>
    </div>
  </div>

  <!-- Add Topic Modal -->
  <div id="addTopicModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="toggleModal('addTopicModal')">&times;</span>
      <h3>Add New Topic</h3>
      <form id="addTopicForm" action="/topics/add" method="POST">
        <input type="hidden" id="addTopicSubjectId" name="subject_id" value="" />
        <input type="text" name="title" placeholder="Topic Title" required />
        <button type="submit">Add Topic</button>
      </form>
    </div>
  </div>

  <!-- Edit Subject Modal -->
  <div id="editSubjectModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="toggleModal('editSubjectModal')">&times;</span>
      <h3>Edit Subject</h3>
      <form action="/subjects/update" method="POST">
        <input type="hidden" id="edit-subject-id" name="id" value="">
        <input type="text" id="edit-subject-name" name="name" placeholder="Subject Name" required />
        <input type="date" id="edit-subject-exam-date" name="exam_date" required />
        <button type="submit">Update Subject</button>
      </form>
    </div>
  </div>

  <!-- Edit Topic Modal -->
  <div id="editTopicModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="toggleModal('editTopicModal')">&times;</span>
      <h3>Edit Topic</h3>
      <form action="/topics/update" method="POST">
        <input type="hidden" id="edit-topic-id" name="id" value="">
        <input type="text" id="edit-topic-title" name="title" placeholder="Topic Title" required />
        <textarea id="edit-topic-description" name="description" placeholder="Topic Description (Optional)" rows="4" style="width: 100%; margin-bottom: 1rem; background-color: #1e1e1e; border: 1px solid #555; border-radius: 4px; color: white; padding: 0.5rem;"></textarea>
        <button type="submit">Update Topic</button>
      </form>
    </div>
  </div>

  <!-- Calendar Modal -->
  <div id="calendarModal" class="modal">
    <div class="modal-content calendar-modal-wide">
      <span class="close" onclick="toggleModal('calendarModal')">&times;</span>
      <h3 style="font-size: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">Exam Calendar</h3>
      
      <div class="calendar-layout-container">
        <!-- Left Side: Calendar Grid -->
        <div class="calendar-left-side">
          <div class="calendar-header">
            <button id="prevMonth" class="nav-btn">&lt;</button>
            <h2 id="monthDisplay">Month Year</h2>
            <button id="nextMonth" class="nav-btn">&gt;</button>
          </div>
          <div class="calendar-grid-header">
            <div>S</div><div>M</div><div>T</div><div>W</div><div>T</div><div>F</div><div>S</div>
          </div>
          <div id="calendarGrid" class="calendar-grid"></div>
        </div>

        <!-- Right Side: Exam List -->
        <div class="calendar-right-side">
          <div class="monthly-exams">
            <h4>Exams this month</h4>
            <div id="monthlyExamList"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Hidden Subjects Modal -->
  <div id="hiddenSubjectsModal" class="modal">
    <div class="modal-content" style="max-width: 450px;">
      <span class="close" onclick="toggleModal('hiddenSubjectsModal')">&times;</span>
      <h3 style="margin-bottom: 1.5rem; border-bottom: 1px solid #444; padding-bottom: 0.5rem;">👁️ Hidden Subjects</h3>
      
      <div id="hiddenSubjectsList">
        <% if (hiddenSubjects.length === 0) { %>
          <p style="text-align: center; color: #666; font-style: italic; padding: 2rem 0;">No subjects are currently hidden.</p>
        <% } else { %>
          <ul style="list-style: none; padding: 0;">
            <% hiddenSubjects.forEach(s => { %>
              <li style="display: flex; justify-content: space-between; align-items: center; padding: 0.8rem; background-color: #262626; border-radius: 8px; margin-bottom: 0.5rem;">
                <span style="font-weight: 500;"><%= s.name %></span>
                <form action="/subjects/unhide" method="POST" style="margin: 0;">
                  <input type="hidden" name="id" value="<%= s.id %>">
                  <button type="submit" class="unhide-btn" style="padding: 5px 12px; font-size: 0.8rem;">Unhide</button>
                </form>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    const examDates = <%- JSON.stringify(subjects.map(s => ({ 
      name: s.name, 
      date: s.exam_date, 
      topics: topics.filter(t => t.subject_id === s.id).map(t => t.title)
    }))) %>;
  </script>
  <script src="js/main.js"></script>
</body>
</html>
